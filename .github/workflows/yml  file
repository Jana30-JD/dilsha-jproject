name: Deploy to Red Hat EC2

on:
  push:
    branches:
      - feature/naidu

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Deploy to EC2
        uses: appleboy/ssh-action@v1.2.0
        with:
          host: ${{ secrets.EC2_HOST }}
          username: ${{ secrets.EC2_USER }}
          key: ${{ secrets.EC2_SSH_KEY }}
          script: |
            cd /home/ec2-user/dilsha-jproject
            git pull origin feature/nadiu
            npm install
            npm run build
            pm2 restart dilsha-jproject || pm2 start npm --name dilsha-jproject -- start
            pm2 save
